{
  "manifest_version": 3,
  "name": "TopLock-Antincognito",
  "version": "1.1.0",
  "description": "Automatically closes incognito windows. Requires Allow in incognito to be enabled in Chrome extension settings.",
  "minimum_chrome_version": "109",
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TopLock-Antincognito \u2014 setup and status",
    "default_popup": "status.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "status.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
